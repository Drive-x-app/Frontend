# Expo Mobile App Environment Variables
# In Expo, variables prefixed with EXPO_PUBLIC_ are embedded into the client bundle
# Do not store sensitive secrets or private keys in this file.

# Backend API Base URL
# NOTE: For physical devices testing over Wi-Fi, replace localhost with your computer's LAN IP (e.g., http://192.168.1.100:4000/api)
EXPO_PUBLIC_API_URL="http://localhost:4000/api"

# WebSocket Server URL
EXPO_PUBLIC_WS_URL="http://localhost:4000"
